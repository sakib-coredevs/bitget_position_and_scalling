# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/bitget_trading

# Bitget API Credentials
BITGET_API_KEY=your_api_key_here
BITGET_API_SECRET=your_api_secret_here
BITGET_PASSPHRASE=your_passphrase_here

# Trading Mode
# Set to 'true' for paper trading, 'false' for real trading
PAPER_TRADE=true

# Logging
LOG_LEVEL=info